# Copy to .env and fill in. .env is gitignored.

# Neon Postgres connection string. Provision a free DB at neon.tech.
DATABASE_URL=

# Twilio — used to send SMS (booking confirmations, reminders, waitlist alerts).
# Find these in your Twilio console. Leave blank to run in log-only mode:
# the app prints the SMS it WOULD send instead of charging your account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Shared secret. Set the same value in your Vapi tool headers (x-vapi-secret)
# so random people can't hit your booking endpoints. Generate any long string.
VAPI_SECRET=

# Port the server listens on.
PORT=3000

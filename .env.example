# Copy to .env and fill in. .env is gitignored.

# Neon Postgres connection string. Provision a free DB at neon.tech.
DATABASE_URL=

# Twilio — used to send SMS (booking confirmations, reminders, waitlist alerts).
# Find these in your Twilio console. Leave blank to run in log-only mode:
# the app prints the SMS it WOULD send instead of charging your account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Shared secret. Set the same value in your Vapi tool headers (x-vapi-secret)
# so random people can't hit your booking endpoints. Generate any long string.
VAPI_SECRET=

# Vapi publishable/public key (browser-safe). Powers the dev web-test page at
# /web-test.html so you can talk to the assistant from your laptop — no phone.
VAPI_PUBLIC_KEY=

# Public base URL Vapi uses to reach your tool webhook during a web-test call
# (e.g. your ngrok URL). Leave blank if you open the test page via that URL.
PUBLIC_URL=

# Port the server listens on.
PORT=3000
